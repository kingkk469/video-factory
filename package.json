{
  "name": "video-factory",
  "version": "1.0.1",
  "description": "AI 短视频自动化生产工具",
  "author": "Video Factory",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.videofactory.app",
    "productName": "Video Factory",
    "directories": {
      "output": "dist2"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "renderer/**",
      "scripts/**",
      "publish/**",
      "bundle/**",
      "!scripts/__pycache__/**",
      "!scripts/**/*.pyc"
    ],
    "asarUnpack": [
      "bundle/**"
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "dependencies": {
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}
